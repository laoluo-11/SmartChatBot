# 阿里云百炼 Qwen 大模型 + DashScope TTS 配置
# 复制本文件为 .env，填入你的实际值
# 注意：.env 包含敏感信息，请勿提交到 Git

# 【必填】百炼 API Key
QWEN_API_KEY=sk-xxx

# 【可选】API 地址（默认百炼北京区域；独立业务空间填你的 base_url）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 【可选】LLM 模型名（默认 qwen3-omni-flash，纯文本对话即可）
# QWEN_MODEL=qwen3-omni-flash

# 【可选】对话记忆轮数（默认 5）
# QWEN_HISTORY_TURNS=5

# 【可选】百炼业务空间 ID（用于 TTS WebSocket 地址）
# QWEN_WORKSPACE_ID=ws-vvchkx3qqa728hg2

# 【可选】TTS 模型（默认 qwen-audio-3.0-tts-flash）
# TTS_MODEL=qwen-audio-3.0-tts-flash

# 【可选】TTS 音色（默认 longanhuan_v3.6，优质中文女声）
# TTS_VOICE=longanhuan_v3.6
